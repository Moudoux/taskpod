# Local package for taskpod. Build from this directory with `makepkg -si`.
#
# This lives in dist/arch/ rather than the project root because makepkg uses
# a src/ directory next to the PKGBUILD as its build area: in the root, that
# would be the project's own src/.

pkgname=taskpod
pkgver=0.21.0
pkgrel=1
pkgdesc="Declarative task runner: tasks declare dependencies and run in parallel"
arch=(x86_64 aarch64)
url="https://github.com/Moudoux/taskpod"
license=(MIT)
depends=(gcc-libs glibc)
optdepends=(
  'sudo: root files and sudo steps'
  'openssh: configuring another machine with --host'
  'sops: secrets files ({{ secrets.name }})'
  'age: age-key, with the age plugin it names if any'
)
makedepends=(cargo)
# makepkg's LTO adds -flto to CFLAGS, so the bundled SQLite would be compiled
# to GCC LTO bytecode that Rust's linker can't read (undefined sqlite3_*
# symbols). Cargo's own LTO (Cargo.toml) still applies.
options=(!lto)

_root="$startdir/../.."

prepare() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release
}

check() {
  cd "$_root"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen
}

package() {
  install -Dm755 "$srcdir/target/release/taskpod" "$pkgdir/usr/bin/taskpod"
  install -Dm644 "$_root/README.md" "$pkgdir/usr/share/doc/taskpod/README.md"
  install -Dm644 "$_root/spec.task" "$pkgdir/usr/share/doc/taskpod/spec.task"
  install -Dm644 "$_root/Task.xml" "$pkgdir/usr/share/taskpod/Task.xml"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/taskpod/LICENSE"
}
