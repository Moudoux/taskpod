let name = "taskpod"
let version = $(awk -F'"' '/^version *=/ {print $2; exit}' Cargo.toml)

task lint {
    desc "Lint {{ name }}"
    manual
    run cargo fmt
    run cargo clippy --all-targets --fix --allow-dirty
}

task test {
    desc "Test {{ name }}"
    manual
    run cargo test
}

task release {
    desc "Build {{ name }} {{ version }}"
    run cargo build --release
    run cp target/release/{{ name }} ./{{ name }}
}

task windows-release {
    desc "Build {{ name }} {{ version }} for Windows"
    let target = "x86_64-pc-windows-gnu"
    run cargo build --release --target {{ target }}
    run cp target/{{ target }}/release/{{ name }}.exe ./{{ name }}.exe
}

task install {
    desc "Install {{ name }} {{ version }} to /usr/local/bin"
    needs release
    ask "Install {{ name }} to /usr/local/bin?"
    run sudo install -Dm755 ./{{ name }} /usr/local/bin/{{ name }}
}
