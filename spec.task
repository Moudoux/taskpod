# Taskpod task file reference. Every statement fits on one line; end a line
# with \ to continue it on the next. Comments start with #.
#
#   taskpod spec.task          run every task that isn't manual
#   taskpod spec.task -D       compare with the system: only what would change, with file diffs
#   taskpod spec.task -d       dry run: every task and step, change nothing
#   taskpod spec.task --pull   bring changed files back from the system into
#                              the task files, -D or -d only show what would change
#   taskpod spec.task -H host  run on another machine over SSH, nothing to install there
#   taskpod spec.task -r hello run one task, and the tasks it needs
#   taskpod spec.task -u       undo every task (see Undo below), -D or -d only show it
#   taskpod spec.task --adopt  record what `new` steps say in the undo journal,
#                              so `new` can come out (see Undo), -D or -d only show it
#   taskpod spec.task -l       list tasks
#   taskpod spec.task -g       the task graph: each task with what runs before it
#                              (-g dot for Graphviz, -g mermaid)
#   taskpod spec.task --sources
#                              every file it reads and the secrets each task uses
#   taskpod spec.task --check  check the file for errors
#   taskpod spec.task -D --json --no-secrets
#                              the diff as JSON for editors, without decrypting secrets

# Variables. Use them anywhere with {{ name }}. Strings in "double quotes"
# understand \n, \t, \" and \; 'single quotes' are taken as written.
let greeting = "Hello"
let today = $(date +%A)        # shell output, run once when first used
# Questions, asked once when first used (pausing the live display):
#   let games = confirm "Install games?"         true or false, so `if {{ games }}` works
#   let desktop = choose "Desktop?" kde gnome    one of the options
#   let host = input "Hostname" "archbox"        text, with an optional default
# Without a terminal: confirm is false, choose takes the first option, input the default.
# Built in: {{ home }}, {{ user }}, {{ pwd }} and {{ dir }} (this file's
# directory). Unknown names fall back to environment variables: {{ HOME }}.
# {{ tmp }} is a new empty directory on the machine being configured, made
# when first used: one for each task (its inline blocks share it) and one for
# each template call, deleted once that ends (a dry run shows
# $TMPDIR/taskpod.XXXXXX). So a task can download into it in one step and
# install from it in the next.

# Load KEY=value lines as variables, also exported to every command:
#   env ".env"
# Load a YAML (or JSON) file's values as variables, nested keys joined with
# dots and list items numbered from 0, with `as name` before them: so
# `uv: {version: 0.13.9}` is {{ versions.uv.version }}. Good for keeping every
# version and checksum in one file. Values are used as written, not templated,
# and not exported to commands.
#   vars "versions.yaml" as versions
# Secrets from a sops-encrypted file (YAML, JSON, .env or INI), used as
# {{ secrets.name }}; nested keys join with dots: {{ secrets.wifi.password }}.
# Decrypted with `sops` the first time a secret is used, so runs that don't
# use one need no key. Values are hidden from output (shown as ••••), and
# `taskpod FILE --secrets other.yaml` adds files from the command line.
# A `*` or `?` in the file name (not its directories) names every file there
# that matches, in order:
#   secrets "secrets.yaml"
#   secrets "secrets/*.yaml"
# Each file is unlocked on its own, so with a security key, several files
# mean several PINs and touches. An age identity encrypted to the key, that
# the files are also encrypted to, is decrypted once and unlocks them all
# (or `taskpod FILE --age-key taskpod.key.age`):
#   age-key "taskpod.key.age"
# It's decrypted with sops' identity file (~/.config/sops/age/keys.txt). If
# it's encrypted to a plugin recipient that holds everything needed, like
# age-plugin-fido2-hmac without a separate identity, name the plugin instead
# and no identity file is needed (`age -d -j fido2-hmac`, or `--age-plugin`):
#   age-key "taskpod.key.age" plugin fido2-hmac
# Merge another file, paths are relative to this one; `if`/`unless` optional:
#   include "desktop.task" if pacman -Q plasma-workspace
#   include "kde.task" if which plasmashell
# Commands run with `sh -ec` by default, change it with:
#   shell "bash -eo pipefail -c"

# A string after the name is the task's description, shown when it runs
# (or `desc "..."` in the body).
task main "{{ greeting }} on a {{ today }}" {
    # Each `run` is a shell command, passed to the shell as written.
    run echo "Hello main!"
    # A block runs as one script, so `cd` and shell variables carry over.
    run {
        cd /tmp
        name=$(whoami)
        echo "Hello $name from $(pwd)"
    }
}

task hello {
    # Run after these tasks. They run either way (unless skipped by a guard),
    # but if one fails, this task doesn't run. Also `task hello needs main {`.
    needs main
    # Guards, all must pass for the task to run:
    #   if <check>         run only if the check passes
    #   unless <check>     skip if the check passes
    #   ask "Question?"    ask first (a dry run assumes yes)
    # A check is a shell command that passes when it succeeds, or one of these
    # built-in checks, which need no shell (when the whole check is one of them):
    #   exists "path"          something is at the path (through symlinks), on the
    #                          machine being configured; relative to the workdir
    #   which name             a program on the PATH (an `env` file's PATH counts),
    #                          or with a /, an executable file
    #   $(command) == "value"  what the command prints, trimmed, is the value;
    #                          whether it succeeds doesn't matter, and what it
    #                          prints on stderr is dropped, so a failing command
    #                          prints "". Also != "value", contains "text", and
    #                          has-line "text": one of its lines is the text,
    #                          ignoring spaces at either end
    # Anything else is shell, like `exists x` without quotes or `$(cmd) args`.
    if test -d /tmp
    unless exists "/tmp/taskpod-never-exists"
    if $(uname -s) != ""
    run echo "Hello"
    # End a guard with { to only guard the steps inside, not the whole task.
    unless test -e /tmp/taskpod-hello {
        run touch /tmp/taskpod-hello
    }
    # An `if` block can have an `else`, which runs when the check fails (it
    # runs once, so the first block can't change which one runs). For
    # `unless X { A } else { B }`, write `if X { B } else { A }`.
    if test -d /tmp {
        run echo "/tmp is there"
    } else {
        notice "no /tmp"
    }
    # `changed {` only runs if an earlier step in this task changed something,
    # like restarting a service after its config file. In a template, a
    # `changed` line makes the whole call wait for a change before it in the
    # calling task. `changed run <command>` is a block with one command.
    # In undo: a `changed` block (or template) with only `run` commands, and
    # no `undo` or `keep`, runs again once the files, lines and settings right
    # before it (back to the command or template call before them) are undone,
    # if that changed something: the restart picks up the old config, before
    # the package is removed. One with an `undo` runs that where it stands;
    # `keep` leaves it.
    file "/tmp/taskpod-hello.conf" "greeting=hello\n"
    changed {
        run echo "the config changed"
    }
    changed run echo "also after the change"
    # `notice "text"` is a message for whoever runs taskpod: shown under the
    # task, and again above the final summary so it isn't lost (a command's
    # output only shows while it runs). It changes nothing, so a task with
    # only notices is still up to date; --undo and --pull skip them.
    unless exists "/tmp/taskpod-example" {
        notice "/tmp/taskpod-example doesn't exist yet, run -r setup"
    }
    # `wait` checks every second until a check passes (any `if` check), with
    # the message on the task's line meanwhile; already passing, it's done.
    # `timeout 30` gives up after 30 seconds, failing the step. Dry runs and
    # diffs never wait, --undo and --pull skip it, and it changes nothing.
    # While it waits, the task gives its job slot to others.
    #   wait "Insert the security key" until $(fido2-token -L) != ""
    wait timeout 5 until exists "/tmp"
}

# Subtasks run after their parent, and only if the parent changed something:
# not when it was skipped or everything in it was already up to date. Unlike
# a `changed` block, a subtask is its own task, so it can be run with -r.
subtask world of hello {
    run echo "world"
}

# Templates are reusable steps. Call one with words after its name: inside
# the template, {{ args }} is all of them as written and {{ 1 }}, {{ 2 }},
# ... each one. A word is split on spaces once its variables are filled in,
# unless it's quoted: "two words" or 'two words' is one.
# Name the parameters in parentheses after the template's name,
# `name="default"` for optional ones (last): a call that leaves out a
# required one, or gives too many words, is an error, and `()` takes none.
# A default can use variables and the template's other parameters
# (`pkg="{{ repo }}"`). Without parentheses, a template takes any number of words.
# A call can give a parameter by name, `greeting=hi`, anywhere among its
# words (the others fill the parameters in order), which also skips optional
# ones before it. Only a parameter's name counts: other `x=y` words are
# words, like in a template without parameters.
# A template's guards only apply to that call, so a task can mix calls that
# are already done with ones that still need to run. A template's own
# `let $( )` or question that uses {{ }} is worked out again for each call.
template note {
    unless test -e /tmp/taskpod-{{ 1 }}
    run echo "{{ args }}"
}

task notes {
    note first one
    note second
}

template greet(who, greeting="hello") {
    run echo "{{ greeting }}, {{ who }}"
}

# `workdir` in a template or an inline block is where its steps run, relative
# to the directory around it. Its own guards are checked outside it: they say
# whether to go in. Each call gets its own {{ tmp }}, so a template can build in it:
template build-from(repo) {
    run git clone -q {{ repo }} {{ tmp }}
    if exists "{{ tmp }}/Makefile" {
        workdir "{{ tmp }}"
        run make
    }
}

task greetings {
    greet world                  # hello, world
    greet you hi                 # hi, you
    greet greeting=hey "you two" # hey, you two
    # A call that ends in `{` calls the template once for each line, with the
    # line's words after the ones before the `{`:
    greet everyone {
        hi                       # hi, everyone
        greeting=welcome         # welcome, everyone
    }
}

task setup {
    manual                     # only runs with -r, or when another task needs it
    workdir "/tmp"             # where commands run, default: this file's directory
                               # (in a template or block: see build-from above)
    let where = "{{ home }}"   # variables can be per task
    # Files are written only when their content, mode or owner differs (through
    # symlinks); diffs say when only the encoding, line endings or final newline do.
    #   mode 600           permission bits, default 644, or 755 for content starting with #!
    #   owner user:group   checked and set, writes with sudo
    #   encoding utf-16le  utf-8 (default), utf-8-bom, utf-16le, utf-16be, latin1 or ascii
    #   sudo               write as root, renaming a new file over the old one, so
    #                      programs watching the directory never see it go missing.
    #                      Running, it also reads and checks the file as root when
    #                      the user can't (in a directory only root can enter, like
    #                      /var/lib/x of mode 750); -d and -D never use sudo, so
    #                      they say they can't read it rather than call it new
    #   new                taskpod created it: --undo deletes it (see Undo below)
    #   keep               --undo leaves it as it is
    #   template           fill in {{ }} in a `from` file, like inline content
    #                      (\{{ is a literal {{); --pull keeps lines with a variable
    # Content is a string, a """ block, `from "path"` (relative to this file,
    # copied byte for byte unless an encoding is given), or `url "..." sha256
    # "..."`: downloaded with curl on this machine and checked against the
    # sha256, which is required (it can be a {{ variable }}). When the file
    # there already has that sha256, nothing is downloaded. --pull leaves it alone.
    #   file "/etc/apt/keyrings/docker.asc" sudo new \
    #       url "https://download.docker.com/linux/debian/gpg" sha256 "<its sha256>"
    file "/tmp/taskpod-example/hello.sh" """
        #!/bin/sh
        echo "hello from {{ where }}"
        """
    file "/tmp/taskpod-example/copy.task" mode 600 from "spec.task"
    #   file "~/app/compose.yml" template from "files/compose.yml"
    file "/tmp/taskpod-example/windows.txt" encoding utf-16le "for notepad\n"
    # `directory` copies every file in a `from` directory (subdirectories
    # included), each like its own file step with the same options. Files
    # there that the directory doesn't have are left alone, and --pull
    # copies them into it: only from directories the source has too (not an
    # app's data/ next to its config), and not ones other steps of the task
    # write (like a secrets file written inline).
    directory "/tmp/taskpod-example/editors" from "editors/vscode/syntaxes"
    # Without `from`, only the directory: made if it's missing (with its
    # parents), with `mode` (default 755) and `owner`. Undo deletes one
    # taskpod made only once it's empty, and puts back a mode or owner it
    # changed; `keep` leaves it (a data directory).
    directory "/tmp/taskpod-example/data" mode 750 keep
    # `line` makes sure a file that's otherwise left alone (a package's, or
    # yours) has one line, compared ignoring spacing (`before`, `after` and
    # `match` too: a tab or a run of spaces is one space). Missing, it goes before
    # the first other line starting with `before`, after the last starting
    # with `after`, or at the end; on the wrong side of it, it's moved. With
    # `match "start"`, a line starting with that is this step's line, and is
    # replaced rather than added again. So is the line taskpod last wrote for
    # the step (from the journal), which a `match "#Option"` for a commented-out
    # default no longer finds once it's replaced. One on the right side of `before` or
    # `after` counts first, so the same line can be elsewhere too (an
    # `Include` in each of pacman.conf's sections); when several are on the
    # wrong side and none on the right, they stay and it's added. The file
    # must exist, or with `base
    # "path"` (on the machine being configured) it starts as a copy of that,
    # for overrides of vendor files. `sudo` reads and writes as root, keeping
    # the owner and mode. The journal records what taskpod added or replaced,
    # so --undo takes out only that (asking if it changed since), and deletes
    # a file taskpod created once it's the base again. A line with no record
    # is left; `new` says taskpod added it. `keep`: undo leaves it.
    #   line "~/.bashrc" ". ~/.scripts/functions.sh"
    #   line "/etc/pam.d/kde" sudo base "/usr/lib/pam.d/kde" match "auth sufficient pam_u2f.so" \
    #       before "auth" "auth sufficient pam_u2f.so cue"
    # Several lines in one file: `lines "path" [options] {` with a line of
    # `[options] "text"` for each, like a `line` step each. The options before
    # the `{` (not `match`) are every line's; a line's own add to them, and
    # its `before` or `after` replaces theirs.
    #   lines "/etc/pacman.conf" sudo {
    #       match "#Color" "Color"
    #       match "#ParallelDownloads" "ParallelDownloads = 10"
    #   }
    run /tmp/taskpod-example/hello.sh
    # A `setting` is a value that commands read and write. `get` prints it
    # (compared trimmed); when that's not the value, `set` runs with it as
    # {{ value }}, and then `get` must print it. Diffs show the old and new
    # value. The journal keeps what `get` printed before taskpod first set
    # it, so --undo sets that again (`keep`: undo leaves it). `default "x"` is
    # what undo sets without a record, like for a value set before taskpod
    # kept one. `get` and `set` can be `{` blocks like `run`. `setting name =
    # "value" {` names it in the output, instead of its `get` command.
    setting file-manager = "org.kde.dolphin.desktop" {
        get xdg-mime query default inode/directory
        set xdg-mime default {{ value }} inode/directory
    }
}

# Undo. `taskpod FILE --undo` (or -u) undoes every task, `-u -r name` one task
# and its subtasks, not what it needs; a task others still need isn't undone
# unless they're in -r too. Dependents go first, subtasks before
# their parent, and in a task the steps run last first:
# - Files go back to what they were before taskpod first wrote them (content,
#   mode, owner and modification time), from a journal on the machine: SQLite
#   databases at ~/.local/state/taskpod/journal.db, and
#   /var/lib/taskpod/journal.db (root only) for what's written as root. A file
#   without a record is deleted if it says `new`, otherwise reported. A file
#   taskpod writes now is in the journal from the start; `new` is for one
#   written before taskpod kept a journal. `taskpod FILE --adopt` records what
#   each `new` step says for the files and lines on the system (taskpod
#   created the file, or added the line), after which `new` can come out. One
#   changed since taskpod wrote it is asked about (--yes: undone). Checks read
#   root's journal, and files only root can read, only with --root.
# - Commands can't be undone by themselves: `undo` gives the command that
#   does, like `run`, and runs where it stands. A block with commands but no
#   `undo` is reported, unless it says `keep`: leave it as it is, or it's a
#   `changed` block, which runs again after the files before it are undone.
# - Settings are set back to their value from the journal.
# - In undo, `unless` says when there's something to undo (its check passes
#   when the task is done) and `if` still says where the task applies.
template service {
    unless systemctl is-enabled -q {{ args }}
    run sudo systemctl enable --now {{ args }}
    undo sudo systemctl disable --now {{ args }}
}

task undo-example {
    manual
    file "/tmp/taskpod-example/app.conf" new "port=8080\n"
    unless test -d /tmp/taskpod-example/data {
        keep                   # data stays
        run mkdir -p /tmp/taskpod-example/data
    }
    # At the end, so it runs first in an undo, before the file goes:
    undo echo "stopping the app"
}

# The flags `sudo`, `terminal`, `keep`, `manual` and `interactive` can also
# go before `task`, `subtask` or `template`, and `needs` and `lock` after its
# name (after a template's parameters), so the body is only what it does.
# Both places work, and add up: `needs` in the header and the body are all needed.
# Continue a long header with \ like any line.
#   sudo template pkg needs yay lock pacman { ... }
#   sudo interactive task update-aur needs yay lock pacman { ... }
#   subtask notify of build needs mail { ... }
manual terminal task install-tool {   # its installer asks for root itself, with `sudo -k`
    unless command -v example-tool
    run ./install.sh --prefix /usr/local
}

# More directives (in the body, or in the header as above):
#   lock name     tasks holding the same lock never run at the same time,
#                 e.g. `lock pacman` for package installs
#   sudo          ask for sudo before running; commands mentioning sudo do this
#                 automatically, so parallel tasks never prompt at once.
#                 Implies `terminal`
#   terminal      a command that asks on the terminal anyway (a tool that runs
#                 `sudo -k`, doas, su, a key touch, a question) gets it when it
#                 asks: the live display pauses until the command ends, and
#                 tasks that ask at once take turns. Other tasks keep running
#   interactive   this task gets the terminal: nothing else runs alongside it,
#                 the live display pauses, and its commands can ask questions
#
# Commands run in the background of the terminal, like a shell's `cmd &`, so
# one that reads the terminal (or writes to it: taskpod sets `stty tostop`
# while it runs) is stopped right away instead of waiting out of sight.
# Without `terminal`, `sudo` or `interactive` it's ended, and the step fails
# saying it wanted the terminal; so does any `if`/`unless` check or `$( )`
# variable, and every command in dry runs, diffs, --json, without a terminal,
# and over --host (remote commands have no terminal; remote sudo uses the
# password taskpod asked for). Commands still share taskpod's terminal
# session, so sudo's cached credentials apply to them.
#
# While running, each task gets a live spinner with its latest output, above
# an overall progress bar. Failed tasks show their last output; -v streams
# everything, and --plain (or no terminal) prints output prefixed by task.
