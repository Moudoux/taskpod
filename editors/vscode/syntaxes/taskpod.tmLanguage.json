{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Taskpod",
  "scopeName": "source.taskpod",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#let"
    },
    {
      "include": "#statement"
    },
    {
      "include": "#run-block"
    },
    {
      "include": "#run-line"
    },
    {
      "include": "#guard"
    },
    {
      "include": "#needs"
    },
    {
      "include": "#lock"
    },
    {
      "include": "#file"
    },
    {
      "include": "#directive"
    },
    {
      "include": "#call"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comment": {
      "match": "(^|(?<=\\s))(#).*$",
      "name": "comment.line.number-sign.taskpod",
      "captures": {
        "2": {
          "name": "punctuation.definition.comment.taskpod"
        }
      }
    },
    "definition": {
      "begin": "^\\s*((?:(?:sudo|terminal|keep|manual|interactive)\\s+)*)(task|subtask|template)\\s+([\\p{L}\\p{N}_.+-]+)(?:\\s+(of)\\s+([\\p{L}\\p{N}_.+-]+))?",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.taskpod"
        },
        "2": {
          "name": "storage.type.$2.taskpod"
        },
        "3": {
          "name": "entity.name.function.taskpod"
        },
        "4": {
          "name": "keyword.other.of.taskpod"
        },
        "5": {
          "name": "entity.name.function.taskpod"
        }
      },
      "end": "(?=\\{)|(?<![\\\\\\n])$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "\\b(needs)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.needs.taskpod"
            }
          },
          "end": "(?=\\{|\\block\\b)|(?<![\\\\\\n])$",
          "patterns": [
            {
              "match": "[\\p{L}\\p{N}_.+-]+",
              "name": "entity.name.function.taskpod"
            }
          ]
        },
        {
          "begin": "\\b(lock)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.lock.taskpod"
            }
          },
          "end": "(?=\\{|\\bneeds\\b)|(?<![\\\\\\n])$",
          "patterns": [
            {
              "match": "[\\p{L}\\p{N}_.+-]+",
              "name": "variable.other.constant.lock.taskpod"
            }
          ]
        },
        {
          "include": "#strings"
        },
        {
          "match": "([\\p{L}\\p{N}_.+-]+)(=)?",
          "captures": {
            "1": {
              "name": "variable.parameter.taskpod"
            },
            "2": {
              "name": "keyword.operator.assignment.taskpod"
            }
          }
        }
      ]
    },
    "let": {
      "begin": "^\\s*(let)\\s+([\\p{L}\\p{N}_.+-]+)\\s*(=)\\s*(?:(choose|input|confirm)\\b)?",
      "beginCaptures": {
        "1": {
          "name": "storage.type.let.taskpod"
        },
        "2": {
          "name": "variable.other.definition.taskpod"
        },
        "3": {
          "name": "keyword.operator.assignment.taskpod"
        },
        "4": {
          "name": "support.function.prompt.taskpod"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "begin": "\\$\\(",
          "end": "\\)(?=\\s*(#.*)?$)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.taskpod"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.taskpod"
            }
          },
          "contentName": "meta.embedded.line.shell",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "include": "source.shell"
            }
          ]
        },
        {
          "include": "#strings"
        },
        {
          "match": "[\\p{L}\\p{N}_.+-]+",
          "name": "string.unquoted.taskpod"
        }
      ]
    },
    "statement": {
      "patterns": [
        {
          "match": "^\\s*(age-key)\\s+(\"[^\"]*\"|'[^']*')\\s+(plugin)\\s+([\\p{L}\\p{N}_.+-]+)",
          "captures": {
            "1": {
              "name": "keyword.control.import.taskpod"
            },
            "2": {
              "name": "string.quoted.taskpod"
            },
            "3": {
              "name": "entity.other.attribute-name.taskpod"
            },
            "4": {
              "name": "variable.other.constant.plugin.taskpod"
            }
          }
        },
        {
          "match": "^\\s*(include|env|secrets|age-key|shell)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.import.taskpod"
            }
          }
        }
      ]
    },
    "run-block": {
      "begin": "^(\\s*)(?:(changed)\\s+)?(run|undo|get|set)\\s*(\\{)\\s*(?=(#.*)?$)",
      "beginCaptures": {
        "2": {
          "name": "keyword.control.conditional.taskpod"
        },
        "3": {
          "name": "support.type.step.taskpod"
        },
        "4": {
          "name": "punctuation.section.block.begin.taskpod"
        }
      },
      "end": "^\\1(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.block.end.taskpod"
        }
      },
      "contentName": "meta.embedded.block.shell",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "source.shell"
        }
      ]
    },
    "run-line": {
      "begin": "^\\s*(?:(changed)\\s+)?(run|undo|get|set)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.conditional.taskpod"
        },
        "2": {
          "name": "support.type.step.taskpod"
        }
      },
      "end": "(?<![\\\\\\n])$",
      "contentName": "meta.embedded.line.shell",
      "patterns": [
        {
          "include": "#interpolation"
        },
        {
          "include": "source.shell"
        }
      ]
    },
    "guard": {
      "patterns": [
        {
          "begin": "^\\s*(if|unless)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.conditional.taskpod"
            }
          },
          "end": "\\s*(\\{)\\s*$|(?<![\\\\\\n])$",
          "endCaptures": {
            "1": {
              "name": "punctuation.section.block.begin.taskpod"
            }
          },
          "contentName": "meta.embedded.line.shell",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "include": "source.shell"
            }
          ]
        },
        {
          "match": "^\\s*(ask|changed)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.conditional.taskpod"
            }
          }
        },
        {
          "match": "^\\s*(\\})\\s*(else)\\s*(\\{)",
          "captures": {
            "1": {
              "name": "punctuation.section.block.end.taskpod"
            },
            "2": {
              "name": "keyword.control.conditional.taskpod"
            },
            "3": {
              "name": "punctuation.section.block.begin.taskpod"
            }
          }
        }
      ]
    },
    "needs": {
      "begin": "^\\s*(needs)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.needs.taskpod"
        }
      },
      "end": "(?<![\\\\\\n])$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "[\\p{L}\\p{N}_.+-]+",
          "name": "entity.name.function.taskpod"
        }
      ]
    },
    "lock": {
      "begin": "^\\s*(lock)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.lock.taskpod"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "[\\p{L}\\p{N}_.+-]+",
          "name": "variable.other.constant.lock.taskpod"
        }
      ]
    },
    "file": {
      "begin": "^\\s*(file|directory|line)\\b",
      "beginCaptures": {
        "1": {
          "name": "support.type.step.taskpod"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "match": "\\b(mode)\\s+([0-7]{3,4})\\b",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.taskpod"
            },
            "2": {
              "name": "constant.numeric.octal.taskpod"
            }
          }
        },
        {
          "match": "\\b(encoding)\\s+([\\w-]+)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.taskpod"
            },
            "2": {
              "name": "constant.language.encoding.taskpod"
            }
          }
        },
        {
          "match": "\\b(owner)\\s+([\\w.-]+(?::[\\w.-]+)?)",
          "captures": {
            "1": {
              "name": "entity.other.attribute-name.taskpod"
            },
            "2": {
              "name": "variable.other.constant.owner.taskpod"
            }
          }
        },
        {
          "match": "\\b(sudo|from|url|sha256|new|keep|before|after|base|match)\\b",
          "name": "entity.other.attribute-name.taskpod"
        },
        {
          "include": "#comment"
        }
      ]
    },
    "directive": {
      "patterns": [
        {
          "match": "^\\s*(sudo|terminal|manual|interactive|keep)\\b",
          "captures": {
            "1": {
              "name": "storage.modifier.taskpod"
            }
          }
        },
        {
          "match": "^\\s*(desc|workdir|notice)\\b",
          "captures": {
            "1": {
              "name": "keyword.other.directive.taskpod"
            }
          }
        },
        {
          "begin": "^\\s*(setting)\\b",
          "beginCaptures": {
            "1": {
              "name": "support.type.step.taskpod"
            }
          },
          "end": "(?=\\{)|(?<![\\\\\\n])$",
          "patterns": [
            {
              "include": "#comment"
            },
            {
              "include": "#strings"
            },
            {
              "match": "\\b(default|keep|sudo)\\b",
              "name": "entity.other.attribute-name.taskpod"
            }
          ]
        }
      ]
    },
    "call": {
      "begin": "^\\s+(?!(?:desc|needs|lock|if|unless|ask|changed|sudo|terminal|manual|interactive|workdir|keep|notice|let|run|undo|file|directory|line|setting|get|set|else)\\b)([\\p{L}\\p{N}_.+-]+)(?=\\s|$)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.call.taskpod"
        }
      },
      "end": "(?<![\\\\\\n])$",
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.taskpod",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.taskpod",
          "patterns": [
            {
              "match": "\\\\[nt\"\\\\]",
              "name": "constant.character.escape.taskpod"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "begin": "'",
          "end": "'",
          "name": "string.quoted.single.taskpod",
          "patterns": [
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "match": "(?<!\\\\)(\\{\\{)\\s*([\\p{L}\\p{N}_.\\-/]+)\\s*(\\}\\})",
      "name": "meta.interpolation.taskpod",
      "captures": {
        "1": {
          "name": "punctuation.definition.template-expression.begin.taskpod"
        },
        "2": {
          "name": "variable.other.readwrite.taskpod"
        },
        "3": {
          "name": "punctuation.definition.template-expression.end.taskpod"
        }
      }
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\{",
          "name": "punctuation.section.block.begin.taskpod"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.block.end.taskpod"
        },
        {
          "match": "\\\\$",
          "name": "constant.character.escape.line-continuation.taskpod"
        }
      ]
    }
  }
}
