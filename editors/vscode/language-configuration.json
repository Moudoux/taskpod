{
  "comments": { "lineComment": "#" },
  "brackets": [["{", "}"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "{{", "close": " }}", "notIn": ["comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "\\{\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "folding": {
    "markers": { "start": "\\{\\s*(#.*)?$", "end": "^\\s*\\}" }
  },
  "wordPattern": "[\\w.+-]+",
  "onEnterRules": [
    {
      "beforeText": "\\\\\\s*$",
      "action": { "indent": "none", "appendText": "    " }
    }
  ]
}
